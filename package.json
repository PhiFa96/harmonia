{
  "name": "harmonia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint . && node tools/check-package-graph.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools --noEmit",
    "test": "pnpm -r --if-present test",
    "check:i18n": "node tools/check-translations.ts",
    "check:deno": "npx -y deno@2.9.6 check tools/deno-smoke.ts && npx -y deno@2.9.6 run tools/deno-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@harmonia/config": "workspace:*",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
