# Nur öffentliche Projektwerte, niemals Service-/Secret-Schlüssel.
# Ohne diese Werte bleibt der vollständig lokale Gaststart nutzbar.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativ zum Publishable-Key: EXPO_PUBLIC_SUPABASE_ANON_KEY

# Öffentliche, juristisch geprüfte Dokumente (P2.21). Ohne vollständige Bindung bleibt Checkout aus.
EXPO_PUBLIC_LEGAL_TERMS_DE=
EXPO_PUBLIC_LEGAL_TERMS_EN=
EXPO_PUBLIC_LEGAL_PRIVACY_DE=
EXPO_PUBLIC_LEGAL_PRIVACY_EN=
EXPO_PUBLIC_LEGAL_IMPRINT=

EXPO_PUBLIC_LEGAL_WITHDRAWAL_DE=
EXPO_PUBLIC_LEGAL_WITHDRAWAL_EN=
# Nur nach vollständiger Beleg-/Rechtstext-Abnahme aktivieren; app.config prüft das Manifest.
EXPO_PUBLIC_LEGAL_RELEASE_APPROVED=false
