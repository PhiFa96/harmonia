{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": { "APP_VARIANT": "preview" }
    },
    "beta": {
      "extends": "production",
      "node": "22.23.3",
      "environment": "preview",
      "channel": "beta",
      "distribution": "store",
      "env": { "APP_VARIANT": "production" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    }
  },
  "submit": {
    "beta": { "android": { "track": "internal", "releaseStatus": "draft" } },
    "production": {}
  }
}
