{
  "name": "@harmonia/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Harmonia-App für iOS, Android und Web (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-post-install": "node ../../tools/beta/eas-hook.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=2"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@harmonia/audio": "workspace:*",
    "@harmonia/content": "workspace:*",
    "@harmonia/exercises": "workspace:*",
    "@harmonia/i18n": "workspace:*",
    "@harmonia/notation": "workspace:*",
    "@harmonia/ui": "workspace:*",
    "@motiz88/react-native-midi": "0.0.6",
    "@revenuecat/purchases-js": "1.71.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@vexflow-fonts/bravura": "catalog:",
    "expo": "catalog:",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "catalog:",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "catalog:",
    "intl-pluralrules": "^2.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-native": "catalog:",
    "react-native-audio-api": "0.13.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.14.0",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "catalog:",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "catalog:",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@harmonia/config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest/after-env.ts"
    ],
    "moduleNameMapper": {
      "^pitchy$": "<rootDir>/jest/pitchy-stub.ts",
      "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/lib/module/mock.js",
      "^@harmonia/i18n/content-messages$": "<rootDir>/../../packages/i18n/src/authoring-content-messages.ts",
      "^@harmonia/content/catalogue$": "<rootDir>/../../packages/content/src/authoring.ts",
      "\\.(otf|ttf|mp3)$": "<rootDir>/jest/asset-stub.ts"
    },
    "workerIdleMemoryLimit": "1024MB",
    "reporters": [
      "default",
      "github-actions",
      "<rootDir>/jest/ci-execution-reporter.js"
    ]
  }
}
