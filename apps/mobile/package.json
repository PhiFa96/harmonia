{
  "name": "@harmonia/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Harmonia-App für iOS, Android und Web (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@harmonia/audio": "workspace:*",
    "@harmonia/i18n": "workspace:*",
    "@harmonia/notation": "workspace:*",
    "@harmonia/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@vexflow-fonts/bravura": "catalog:",
    "expo": "catalog:",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "catalog:",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "catalog:",
    "intl-pluralrules": "^2.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-native": "catalog:",
    "react-native-audio-api": "0.13.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@harmonia/config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/react": "catalog:",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ],
    "moduleNameMapper": {
      "\\.(otf|ttf|mp3)$": "<rootDir>/jest/asset-stub.ts"
    }
  }
}
